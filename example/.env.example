# Copy this file to .env and fill in your values.
# Your SuprSend workspace public key.
SUPRSEND_PUBLIC_KEY=

# Optional: base URL of the backend endpoint that mints SuprSend user tokens.
# The example calls GET {url}/authentication-token/{distinctId} and expects
# { "token": "<jwt>" }. Leave blank to identify without a user token.
# e.g. http://localhost:8787
SUPRSEND_AUTH_TOKEN_URL=
